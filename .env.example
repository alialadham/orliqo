# Runtime
APP_URL=http://127.0.0.1:3000
DEMO_MODE=true
DEMO_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_DB_PASSWORD=

# Server-side encryption
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_WEB_SEARCH_ENABLED=false
AI_FIXTURE_MODE=true

# Phase 2 AI provider fallback (server-only keys)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=groq,openrouter,mock
AI_PROMPT_VERSION=phase2-v1
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=true

# Google OAuth, Gmail, and Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Microsoft OAuth and Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Optional email adapters
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEST_MODE=true

# Stripe (test values only until explicitly authorized)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_YEARLY_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_YEARLY_PRICE_ID=
STRIPE_AGENCY_MONTHLY_PRICE_ID=
STRIPE_AGENCY_YEARLY_PRICE_ID=
STRIPE_TEST_MODE=true

# Product analytics and error monitoring
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional licensed research providers
RESEARCH_PROVIDER=
RESEARCH_PROVIDER_API_KEY=
RESEARCH_PROVIDER_BASE_URL=

# Provider safety defaults
EMAIL_DELIVERY_MODE=preview
WHATSAPP_DELIVERY_MODE=no-send
INBOUND_REPLY_SIMULATOR=true
